(api_balancer) {
    reverse_proxy api:8000 api2:8000 {
        lb_policy round_robin
        health_uri /health
        health_interval 10s
        health_timeout 2s
        lb_try_duration 5s
    }
}

{$API_DOMAIN} {
    handle /telegram/webhook {
        reverse_proxy bot:8081 bot2:8081 {
            lb_policy round_robin
            health_uri /health
            health_interval 10s
            health_timeout 2s
            lb_try_duration 5s
        }
    }

    handle {
        import api_balancer
    }
}

:8080 {
    import api_balancer
}
